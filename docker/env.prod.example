# Production environment
NODE_ENV=production
PORT=3001

# Database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=myweb
DB_USER=root
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_DATABASE=myweb

# JWT
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=14d

# External APIs
KAKAO_REST_API_KEY=CHANGE_ME_KAKAO_REST_API_KEY
REACT_APP_KAKAO_REST_API_KEY=CHANGE_ME_KAKAO_REST_API_KEY
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY

# Frontend / backend origins
FRONTEND_ORIGIN=https://your-domain.example
CORS_ORIGIN=https://your-domain.example
CORS_ORIGINS=https://your-domain.example
UPLOAD_CORS_ORIGIN=https://your-domain.example
KAKAO_REDIRECT_URI=https://your-domain.example/api/auth/kakao/callback

# Internal service URLs
AI_SERVER_URL=http://ai-server:8000
GEMINI_ENHANCE_URL=http://backend:3001/api/gemini/enhance
AI_CORS_ORIGINS=https://your-domain.example

# Frontend runtime
REACT_APP_API_URL=/api
REACT_APP_AI_SERVER_URL=/ai
REACT_APP_BACKEND_ORIGIN=https://your-domain.example
REACT_APP_KAKAO_REDIRECT_URI=https://your-domain.example/api/auth/kakao/callback
