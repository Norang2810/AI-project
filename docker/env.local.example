# Local development environment
NODE_ENV=development
PORT=3001

# Database
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=myweb
DB_USER=root
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=14d

# External APIs
KAKAO_REST_API_KEY=CHANGE_ME_KAKAO_REST_API_KEY
REACT_APP_KAKAO_REST_API_KEY=CHANGE_ME_KAKAO_REST_API_KEY
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY

# Frontend / backend origins
FRONTEND_ORIGIN=http://localhost:8081
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
UPLOAD_CORS_ORIGIN=http://localhost:8081
KAKAO_REDIRECT_URI=http://localhost:8081/api/auth/kakao/callback

# Internal service URLs
AI_SERVER_URL=http://ai-server:8000
GEMINI_ENHANCE_URL=http://localhost:3001/api/gemini/enhance
AI_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Frontend runtime
REACT_APP_API_URL=http://localhost:8081/api
REACT_APP_AI_SERVER_URL=http://localhost:8081/ai
REACT_APP_BACKEND_ORIGIN=http://localhost:3001
REACT_APP_KAKAO_REDIRECT_URI=http://localhost:8081/api/auth/kakao/callback
